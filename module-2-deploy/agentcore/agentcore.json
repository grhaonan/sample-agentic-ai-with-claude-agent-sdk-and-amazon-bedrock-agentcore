{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "cosdeploy",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "cosdeploy"
  },
  "runtimes": [
    {
      "name": "cos",
      "build": "Container",
      "entrypoint": "agent_agentcore.py",
      "codeLocation": "chief_of_staff_agent/",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "instrumentation": { "enableOtel": true },
      "envVars": [
        { "name": "CLAUDE_CODE_USE_BEDROCK", "value": "1" },
        { "name": "ANTHROPIC_MODEL", "value": "global.anthropic.claude-opus-4-5-20251101-v1:0" },
        { "name": "ANTHROPIC_SMALL_FAST_MODEL", "value": "global.anthropic.claude-haiku-4-5-20251001-v1:0" }
      ]
    }
  ],
  "memories": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": [],
  "harnesses": []
}