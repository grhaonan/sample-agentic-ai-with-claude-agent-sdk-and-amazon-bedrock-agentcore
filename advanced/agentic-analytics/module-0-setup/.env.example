# Module 0 — Infrastructure setup
# Copy to `.env` (gitignored). Region is the main thing you set here.

# AWS region with Bedrock + Athena access (Phase 1 used us-west-2).
AWS_REGION=us-west-2

# Optional: override the S3 bucket name. Default is
# student-analytics-agent-<your-account-id> (auto-derived).
# S3_BUCKET_NAME=

# AWS credentials come from your standard AWS config (aws configure / SSO / env).
